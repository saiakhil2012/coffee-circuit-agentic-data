# Local-only settings. `scripts/up.sh` copies this to .env and generates a password.
# Couchbase Server Community Edition admin (local container only)
CB_USERNAME=Administrator
CB_PASSWORD=password
# n8n owner account (local container only; used by setup/init_n8n.py)
N8N_OWNER_EMAIL=owner@coffeecircuit.local
N8N_OWNER_PASSWORD=change-me
# Models (Ollama, native on the host)
CHAT_MODEL=qwen3:8b
EMBED_MODEL=nomic-embed-text
